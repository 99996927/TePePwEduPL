# Skopiuj do .env (plik jest w .gitignore) i uzupełnij. Nie commituj prawdziwych wartości.
# Klucz Anthropic (opcjonalny; bez niego czat agenta zwraca 503, reszta systemu działa):
ANTHROPIC_API_KEY=
# Hasło SA bazy w Docker Compose. Zostaw puste: tools/docker/up.sh wygeneruje je przy pierwszym uruchomieniu.
# (tools/dev/run.sh używa osobnej zmiennej HR_DEV_SA_PASSWORD.)
HR_DB_PASSWORD=
